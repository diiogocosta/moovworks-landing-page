---
import { a, t } from '../lib/i18n';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const authored = a(locale);
---

<section class="services section" id="services">
  <div class="shell">
    <header class="section__head reveal">
      <h2 class="section__title">{authored.sections.services}</h2>
      <span class="section__rule" aria-hidden="true"></span>
    </header>

    {/*
      One raised panel holding three hairline-separated rows, rather than three
      identical cards. Same depth, but it keeps the reading order vertical and
      avoids the grid-of-rounded-boxes look the brief calls out as generated.
    */}
    <ul class="services__list reveal">
      {
        dict.services.map((service) => (
          <li class="services__item">
            <h3 class="services__title">{service.title}</h3>
            <p class="services__text">{service.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services__list {
    padding-inline: var(--panel-pad);
    background-color: var(--papel-alto);
    border: var(--hairline);
    border-radius: var(--radius);
  }

  .services__item {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: 0.75rem;
    padding-block: clamp(2rem, 4.5vw, 3.5rem);
    border-block-start: var(--hairline);
  }

  /* The panel's own edge replaces the first row's divider. */
  .services__item:first-child {
    border-block-start: 0;
  }

  /*
   * The marker again, drawn from the left along the row's top edge — the same
   * left-to-right gesture as the hero, at a fraction of the scale. Painted over
   * the existing hairline, so nothing moves and nothing reflows.
   */
  .services__item::before {
    content: '';
    position: absolute;
    inset-inline: calc(var(--panel-pad) * -1);
    inset-block-start: -1px;
    height: 3px;
    background-color: var(--marcador);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--transition-slow);
  }

  @media (hover: hover) {
    .services__item:hover::before {
      transform: scaleX(1);
    }
  }

  .services__title {
    grid-column: 1 / span 6;
    font-size: var(--step-row);
    font-weight: 700;
    font-stretch: 85%;
  }

  .services__text {
    grid-column: 8 / -1;
    color: var(--aco);
  }

  @media (max-width: 767px) {
    .services__title,
    .services__text {
      grid-column: 1 / -1;
    }
  }
</style>
