---
import { t } from '../lib/i18n';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const { services } = dict;
---

<section class="services section" id="services">
  <div class="glow glow--faint services__glow" aria-hidden="true"></div>

  <div class="shell">
    <header class="section__head">
      <h2 class="section__title">{services.title}</h2>
      <p class="section__lead">{services.lead}</p>
      <span class="rule" aria-hidden="true"></span>
    </header>

    {/*
      Five cells, four of them services and the fifth an invitation. The last one
      is the accent, so the page's loudest element is the one pointing at the
      contact form, which is the only thing here that asks for anything.

      The widths are deliberately unequal (7/5, 5/7, then full) and are set in a
      min-width query below, with a single column as the default: declaring the
      twelve-column template here and the spans above the collapse point is how
      five cards end up printed on top of each other on a phone.
    */}
    <ul class="services__grid reveal-group">
      {
        services.items.map((service) => (
          <li class="card services__card reveal">
            <div class="card__core">
              <div class="card__glow services__glow-in" aria-hidden="true" />
              <div class="card__body">
                <span class="chip services__kicker">{service.kicker}</span>
                <h3 class="services__title">{service.title}</h3>
                <p class="services__outcome">{service.outcome}</p>
                <p class="services__text">{service.text}</p>
                <ul class="services__includes">
                  {service.includes.map((item) => (
                    <li class="chip">{item}</li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))
      }

      <li class="card card--accent services__invite reveal">
        <div class="card__core">
          <div class="card__body">
            <h3 class="services__invite-title">{services.invite.title}</h3>
            <p class="services__invite-text">{services.invite.text}</p>
            <a class="btn btn--on-accent services__invite-cta" href="#contact">
              <span>{services.invite.cta}</span>
              <span class="btn__glyph" aria-hidden="true"></span>
            </a>
          </div>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .services__glow {
    inset-block-start: 10%;
    inset-inline-start: -20%;
    width: min(80vw, 760px);
    aspect-ratio: 1;
  }

  .services__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(0.9rem, 2vw, 1.25rem);
  }

  .services__card .card__core,
  .services__invite .card__core {
    /* Cards share a row height, so the chip rows line up across neighbours of
       different text length. */
    justify-content: space-between;
  }

  .services__glow-in {
    inset-block-start: -40%;
    inset-inline-end: -30%;
    width: 70%;
    aspect-ratio: 1;
  }

  .services__kicker {
    align-self: flex-start;
    color: var(--accent-light);
    border-color: rgb(0 217 146 / 0.28);
  }

  .services__title {
    max-width: 20ch;
  }

  /* The reason to care, set in the accent so it cannot be skimmed past as more
     body copy. This is the line the card exists to deliver. */
  .services__outcome {
    max-width: 30ch;
    font-size: var(--step-lead);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--accent-light);
  }

  .services__text {
    color: var(--body);
  }

  .services__includes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding-block-start: 0.35rem;
  }

  /* ---- The invitation -------------------------------------------------- */

  .services__invite-title {
    max-width: 22ch;
    font-weight: 700;
  }

  .services__invite-text {
    max-width: 44ch;
    color: var(--on-accent);
    /* Dimmed ink, not a lighter grey: on a saturated green a grey paragraph
       turns to mud. */
    opacity: 0.78;
  }

  .services__invite-cta {
    align-self: flex-start;
    margin-block-start: 0.5rem;
  }

  /* ---- Desktop --------------------------------------------------------- */

  @media (min-width: 901px) {
    .services__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .services__card:nth-child(1) {
      grid-column: span 7;
    }

    .services__card:nth-child(2) {
      grid-column: span 5;
    }

    .services__card:nth-child(3) {
      grid-column: span 5;
    }

    .services__card:nth-child(4) {
      grid-column: span 7;
    }

    /* The invitation spans the full width and lays its copy out beside the
       heading, because a 12-column cell holding one short paragraph in its left
       third reads as an unfinished row. */
    .services__invite {
      grid-column: span 12;
    }

    .services__invite .card__body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      grid-template-rows: auto auto;
      column-gap: clamp(1.5rem, 4vw, 4rem);
      align-content: center;
    }

    .services__invite-title {
      grid-column: 1;
      grid-row: 1 / span 2;
      align-self: center;
      max-width: 18ch;
    }

    .services__invite-text {
      grid-column: 2;
      grid-row: 1;
    }

    .services__invite-cta {
      grid-column: 2;
      grid-row: 2;
    }
  }
</style>
