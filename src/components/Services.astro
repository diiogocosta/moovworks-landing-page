---
import { t } from '../lib/i18n';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const { services } = dict;
---

<section class="services section" id="services">
  <div class="shell">
    <header class="section__head reveal">
      {/* The page's only eyebrow. One tracked label on the whole site is a
          choice; one above every heading is a template. */}
      <p class="eyebrow">{services.eyebrow}</p>
      <h2 class="section__title">{services.title}</h2>
      <span class="rule" aria-hidden="true"></span>
    </header>

    {/*
      Five cells, deliberately unequal: 5/7, then 7/5, then the umbrella service
      across the full width. An even row of five, or of any number, is the layout
      this page exists to avoid.

      The spans are written as nth-child rules below, so the rhythm assumes five
      services. A sixth would fall to a single column rather than break; if the
      list is ever restructured, re-cut the rhythm on purpose.
    */}
    <ul class="services__list reveal-group">
      {
        services.items.map((service) => (
          <li class="services__item reveal">
            <h3 class="services__title">{service.title}</h3>
            <p class="services__text">{service.text}</p>
            <ul class="services__includes">
              {service.includes.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /*
   * One column by default, and the twelve-column grid only above 901px. The
   * order matters: declaring `repeat(12, ...)` here and relying on the items to
   * span out of it leaves five cells each sitting in a single ~30px column on a
   * phone, which renders as five paragraphs printed on top of each other.
   */
  .services__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: clamp(2.5rem, 5vw, 4rem);
  }

  .services__item {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    padding-block-start: clamp(1.25rem, 2.5vw, 2rem);
    /* The rule above each cell is the only thing separating them: no cards, no
       fills, no shadows. */
    border-block-start: 1px solid var(--line);
  }

  .services__text {
    color: var(--body);
  }

  .services__includes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    /* Pinned to the bottom so the tag rows line up across cells of unequal
       text length. */
    margin-block-start: auto;
  }

  /*
   * The unequal rhythm, and it only exists above the collapse point. Written as
   * a min-width query rather than an override, so the single-column rule below
   * is the default and nothing needs `!important` to beat a nth-child selector.
   */
  @media (min-width: 901px) {
    .services__list {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 4vw, 4rem);
    }

    .services__item:nth-child(1) {
      grid-column: span 5;
    }

    .services__item:nth-child(2) {
      grid-column: span 7;
    }

    .services__item:nth-child(3) {
      grid-column: span 7;
    }

    .services__item:nth-child(4) {
      grid-column: span 5;
    }

    /*
     * The umbrella service, across the full width, and the one cell that is a
     * panel rather than a ruled column. It earns the fill because it is a
     * different kind of engagement from the four above it, so the elevation
     * carries real meaning rather than decoration.
     *
     * It also has to fill the width it claims: a 12-column cell holding three
     * short lines in its left third reads as an unfinished row, so the title sits
     * in its own column and the paragraph and tags share the second.
     */
    .services__item:nth-child(5) {
      grid-column: span 12;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      column-gap: clamp(1.5rem, 4vw, 4rem);
      row-gap: clamp(0.75rem, 1.5vw, 1.25rem);
      align-content: start;
      padding: clamp(1.75rem, 3vw, 2.5rem);
      background-color: var(--canvas-soft);
      border: 1px solid var(--line);
      border-radius: var(--radius-panel);
    }

    .services__item:nth-child(5) .services__title {
      grid-column: 1;
      grid-row: 1;
    }

    .services__item:nth-child(5) .services__text {
      grid-column: 2;
      grid-row: 1;
      max-width: 58ch;
    }

    .services__item:nth-child(5) .services__includes {
      grid-column: 2;
      grid-row: 2;
      margin-block-start: 0;
    }
  }
</style>
