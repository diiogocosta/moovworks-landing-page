---
import { t } from '../lib/i18n';
import { SITE } from '../lib/site';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const mailto = `mailto:${SITE.email}`;
---

<section class="contact section" id="contact">
  <div class="shell">
    {/* No reveal here. This is the page's closing action, and the one thing on
        it that should be present the moment it is on screen rather than arriving
        after it. It is also what keeps the motion to three sections. */}
    <header class="section__head">
      <h2 class="section__title">{dict.contact.title}</h2>
      <span class="rule" aria-hidden="true"></span>
    </header>

    <div class="contact__inner">
      {/* The address carries a title's weight, so the shortest path to the studio
          is legible from across the room. The link text is the address itself,
          which is also what a person copies. */}
      <a class="contact__email" href={mailto}>{SITE.email}</a>
      <a class="btn contact__cta" href={mailto}>{dict.contact.cta}</a>
    </div>
  </div>
</section>

<style>
  .contact__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.5rem, 4vw, 2.25rem);
  }

  .contact__email {
    max-width: 100%;
    font-size: var(--step-section);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ink-strong);
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.1em;
    /* One long unbroken token has to be allowed to wrap, or a 320px screen gets
       a horizontal scrollbar from the address alone. */
    overflow-wrap: anywhere;
    transition: text-decoration-thickness var(--transition);
  }

  .contact__email:hover,
  .contact__email:focus-visible {
    text-decoration-thickness: 6px;
  }

  @media (max-width: 767px) {
    .contact__inner {
      align-items: stretch;
    }
  }
</style>
