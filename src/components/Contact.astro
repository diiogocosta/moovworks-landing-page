---
import { t } from '../lib/i18n';
import { SITE } from '../lib/site';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const mailto = `mailto:${SITE.email}`;
---

<section class="contact section" id="contact">
  <div class="shell">
    <header class="section__head reveal">
      <h2 class="section__title">{dict.contact.headline}</h2>
      <span class="section__rule" aria-hidden="true"></span>
    </header>

    <div class="contact__inner reveal">
      {/* The address carries a title's weight, with the marker on its underline. */}
      <a class="contact__email" href={mailto}>{SITE.email}</a>
      <a class="btn contact__cta" href={mailto}>{dict.contact.button}</a>
    </div>
  </div>
</section>

<style>
  .contact__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.75rem, 4vw, 2.75rem);
  }

  .contact__email {
    max-width: 100%;
    font-family: var(--font-display);
    font-size: var(--step-email);
    font-weight: 700;
    font-stretch: 85%;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-decoration-line: underline;
    text-decoration-color: var(--marcador);
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.12em;
    overflow-wrap: break-word;
    transition: text-decoration-thickness var(--transition);
  }

  .contact__email:hover {
    text-decoration-thickness: 0.16em;
  }

  /* The one shadow in the page's content: the closing action sits above the
     surface rather than in it. */
  .contact__cta {
    padding: 1.15rem 2.25rem;
    font-size: 1.0625rem;
    box-shadow: var(--sombra);
  }

  @media (max-width: 767px) {
    .contact__inner {
      align-items: stretch;
    }
  }
</style>
