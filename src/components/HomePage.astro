---
import About from './About.astro';
import Contact from './Contact.astro';
import Hero from './Hero.astro';
import Pipeline from './Pipeline.astro';
import Principles from './Principles.astro';
import Services from './Services.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homePath } from '../lib/site';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout locale={locale} path={homePath(locale)}>
  <SiteHeader locale={locale} home />

  <main id="main">
    <Hero locale={locale} />
    {/*
      The flow sits before the detail on purpose: the overview first, then the
      five services explained one at a time. It is also the only place the
      services appear as a single row, which is what keeps the grid below from
      reading as a second copy of the same list.
    */}
    <Pipeline locale={locale} />
    <Services locale={locale} />
    {/* Future products slot in here, between Services and Principles. */}
    <Principles locale={locale} />
    <About locale={locale} />
    <Contact locale={locale} />
  </main>

  <SiteFooter locale={locale} />
</BaseLayout>
