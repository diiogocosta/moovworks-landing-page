---
import About from './About.astro';
import Contact from './Contact.astro';
import Hero from './Hero.astro';
import Pipeline from './Pipeline.astro';
import Principles from './Principles.astro';
import Services from './Services.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homePath } from '../lib/site';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout locale={locale} path={homePath(locale)}>
  <SiteHeader locale={locale} home />

  <main id="main">
    <Hero locale={locale} />
    <Services locale={locale} />
    {/*
      The flow follows the cards on purpose: the services are the detail, and this
      is the shape of them. It is also the only place the four names appear as a
      single row, which is what keeps it from reading as a second copy of the grid
      above.
    */}
    <Pipeline locale={locale} />
    {/* Future products slot in here, between Process and Principles. */}
    <Principles locale={locale} />
    <About locale={locale} />
    <Contact locale={locale} />
  </main>

  <SiteFooter locale={locale} />
</BaseLayout>
