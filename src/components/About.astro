---
import { t } from '../lib/i18n';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

{/*
  The founding date, carried entirely by type.

  It is the largest thing on the page, larger than the headline, and that is
  deliberate: the loudest statement Moovworks makes is a fact rather than a claim.
  It is also never rephrased as "15 years", because that ages badly and this does
  not.
*/}
<section class="about section" id="about">
  <div class="shell about__inner">
    <h2 class="about__headline reveal">{dict.about.headline}</h2>
    <p class="about__text reveal">{dict.about.text}</p>
  </div>
</section>

<style>
  .about__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .about__headline {
    grid-column: 1 / -1;
    font-size: var(--step-numeral);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--ink-strong);
  }

  /* Offset into the right half: the empty left column under the headline is part
     of the composition, not an accident. */
  .about__text {
    grid-column: 7 / -1;
    color: var(--body);
  }

  @media (max-width: 767px) {
    .about__text {
      grid-column: 1 / -1;
    }
  }
</style>
