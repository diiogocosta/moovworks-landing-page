---
import { LANG_LABEL, LOCALES, SITE, homePath, legalPath } from '../lib/site';
import { t, ui } from '../lib/i18n';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const strings = ui(locale);
const mailto = `mailto:${SITE.email}`;
// Generated at build time, never written by hand — it must not go stale.
const year = new Date().getFullYear();
---

{/*
  The ink close. The page has argued its case; the footer restates the brand at
  full size and gives the three things a footer is actually for: how to reach
  them, in which language, and the legal links.
*/}
<footer class="site-footer on-ink">
  <div class="shell">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <p class="site-footer__wordmark">moovworks</p>
        <p class="site-footer__tagline">{dict.hero.sub}</p>
      </div>

      <div class="site-footer__col">
        <p class="site-footer__label">{dict.header.contact}</p>
        <a class="site-footer__email" href={mailto}>{SITE.email}</a>
      </div>

      <div class="site-footer__col">
        <p class="site-footer__label">{strings.languageNav}</p>
        <ul class="site-footer__langs">
          {
            LOCALES.map((code) => (
              <li>
                <a
                  class="detail-link"
                  href={homePath(code)}
                  hreflang={code}
                  lang={code}
                  data-lang={code}
                  aria-current={code === locale ? 'page' : undefined}
                >
                  {LANG_LABEL[code]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="site-footer__base">
      <p class="site-footer__copy">&copy; {year} Moovworks</p>

      <ul class="site-footer__legal">
        <li>
          <a class="detail-link" href={legalPath(locale, 'privacy')}>{dict.footer.privacy}</a>
        </li>
        <li>
          <a class="detail-link" href={legalPath(locale, 'terms')}>{dict.footer.terms}</a>
        </li>
      </ul>

      <a class="detail-link site-footer__top-link" href="#main">{strings.toTop}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3.5rem, 9vw, 7rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding-block-end: clamp(3rem, 7vw, 5rem);
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* The wordmark at the size it has earned by the end of the page. */
  .site-footer__wordmark {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3vw, 3.75rem);
    font-weight: 800;
    font-stretch: 85%;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .site-footer__tagline {
    max-width: 30ch;
    color: var(--papel-suave);
  }

  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .site-footer__label {
    font-family: var(--font-display);
    font-size: var(--step-detail);
    font-weight: 500;
    color: var(--papel-suave);
  }

  .site-footer__email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    text-decoration-line: underline;
    text-decoration-color: var(--marcador);
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.18em;
    transition: text-decoration-thickness var(--transition);
  }

  .site-footer__email:hover {
    text-decoration-thickness: 0.2em;
  }

  .site-footer__langs,
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25rem;
    margin-inline-start: -0.4rem;
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem clamp(1rem, 3vw, 2.5rem);
    padding-block-start: clamp(1.25rem, 3vw, 2rem);
    /* A lighter hairline than on concrete: `--nevoa` disappears against ink. */
    border-block-start: 1px solid var(--tinta-borda);
  }

  .site-footer__copy {
    font-family: var(--font-display);
    /* Sentence case throughout: no tracked ALL CAPS labels. */
    font-size: var(--step-detail);
    font-weight: 500;
    color: var(--papel-suave);
  }

  .site-footer__top-link {
    margin-inline-start: auto;
  }

  @media (max-width: 900px) {
    .site-footer__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .site-footer__top {
      grid-template-columns: minmax(0, 1fr);
    }

    .site-footer__top-link {
      margin-inline-start: 0;
    }
  }
</style>
