---
import { LANG_LABEL, LOCALES, SITE, homePath, legalPath } from '../lib/site';
import { t } from '../lib/i18n';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const mailto = `mailto:${SITE.email}`;
// Generated at build time, never written by hand — it must not go stale.
const year = new Date().getFullYear();
---

{/*
  The close. Three things a footer is actually for: how to reach them, in which
  language, and the legal links. No tagline here, because the sentence that would
  go in it is already the hero's, and the same line twice on one page reads as
  filler rather than emphasis.
*/}
<footer class="site-footer">
  <div class="shell">
    <div class="site-footer__top">
      <p class="site-footer__wordmark">moovworks</p>

      <div class="site-footer__col">
        <p class="site-footer__label">{dict.footer.contact}</p>
        <a class="site-footer__email" href={mailto}>{SITE.email}</a>
      </div>

      <div class="site-footer__col">
        <p class="site-footer__label">{dict.ui.languageNav}</p>
        <ul class="site-footer__langs">
          {
            LOCALES.map((code) => (
              <li>
                <a
                  class="detail-link"
                  href={homePath(code)}
                  hreflang={code}
                  lang={code}
                  data-lang={code}
                  aria-current={code === locale ? 'page' : undefined}
                >
                  {LANG_LABEL[code]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="site-footer__base">
      <p class="site-footer__copy">&copy; {year} Moovworks</p>

      <ul class="site-footer__legal">
        <li>
          <a class="detail-link" href={legalPath(locale, 'privacy')}>{dict.footer.privacy}</a>
        </li>
        <li>
          <a class="detail-link" href={legalPath(locale, 'terms')}>{dict.footer.terms}</a>
        </li>
      </ul>

      <a class="detail-link site-footer__top-link" href="#main">{dict.ui.toTop}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(1.5rem, 3vw, 2.5rem);
    border-block-start: 1px solid var(--line);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding-block-end: clamp(2.5rem, 6vw, 4.5rem);
  }

  /* The wordmark at the size it has earned by the end of the page. */
  .site-footer__wordmark {
    font-size: clamp(2rem, 1.2rem + 3vw, 3.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink-strong);
  }

  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .site-footer__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .site-footer__email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
    transition:
      color var(--transition),
      text-decoration-color var(--transition);
  }

  .site-footer__email:hover,
  .site-footer__email:focus-visible {
    color: var(--ink-strong);
    text-decoration-color: var(--accent);
  }

  .site-footer__langs,
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25rem;
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem clamp(1rem, 3vw, 2.5rem);
    padding-block-start: clamp(1.25rem, 3vw, 2rem);
    border-block-start: 1px solid var(--line);
  }

  .site-footer__copy {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--mute);
  }

  .site-footer__top-link {
    margin-inline-start: auto;
  }

  @media (max-width: 900px) {
    .site-footer__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .site-footer__wordmark {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .site-footer__top {
      grid-template-columns: minmax(0, 1fr);
    }

    .site-footer__top-link {
      margin-inline-start: 0;
    }
  }
</style>
