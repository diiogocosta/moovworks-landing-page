---
import { t } from '../lib/i18n';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const { process } = dict;
---

{/*
  What the work looks like end to end: a brief in, four lines running, one
  delivered thing out. It follows the services because the services are the detail
  and this is the shape of them.

  It is the agency's answer to the architecture diagram a developer tool puts in
  this slot, and it is built from real content rather than drawn: two labels, the
  four service names, and a hairline doing the work an arrow would.
*/}
<section class="process section" id="process">
  <div class="glow process__glow" aria-hidden="true"></div>

  <div class="shell">
    <header class="section__head">
      <h2 class="section__title">{process.title}</h2>
      <p class="section__lead">{process.lead}</p>
      <span class="rule" aria-hidden="true"></span>
    </header>

    <div class="process__flow">
      <p class="process__node">{process.from}</p>
      <span class="process__link" aria-hidden="true"></span>
      <ul class="process__lines">
        {dict.services.items.map((service) => <li class="chip">{service.kicker}</li>)}
      </ul>
      <span class="process__link" aria-hidden="true"></span>
      <p class="process__node process__node--end">{process.to}</p>
    </div>
  </div>
</section>

<style>
  .process__glow {
    inset-block-start: 20%;
    inset-inline-end: -25%;
    width: min(70vw, 640px);
    aspect-ratio: 1;
  }

  /*
   * A flex row rather than a grid with drawn connectors: the two accent
   * hairlines are items that grow to fill whatever space is left, so the flow
   * stays correct at any width without measuring anything.
   */
  .process__flow {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 1.6vw, 1.15rem);
    padding: clamp(1.15rem, 2.6vw, 1.75rem);
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0.035),
      rgb(255 255 255 / 0.01)
    );
    border: 1px solid var(--edge);
    border-radius: var(--radius-shell);
  }

  /* The two ends of the flow are states, so they get a solid pill. The middle is
     a list, so it does not: that difference is the whole diagram. */
  .process__node {
    flex: 0 0 auto;
    padding: 0.6rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--step-mono);
    line-height: 1.4;
    white-space: nowrap;
    color: var(--ink);
    background-color: var(--canvas-raised);
    border: 1px solid var(--edge);
    border-radius: var(--radius-pill);
  }

  .process__node--end {
    color: var(--on-accent);
    background-color: var(--accent);
    border-color: transparent;
    box-shadow: 0 0 34px -8px var(--glow-strong);
  }

  .process__lines {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex: 1 1 auto;
    justify-content: center;
  }

  /* The connector. The accent's job here is structural: it says which way the
     work moves, which is the one thing this band has to communicate. */
  .process__link {
    flex: 1 1 2rem;
    min-width: 1.25rem;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--accent) 40%,
      var(--accent)
    );
    border-radius: var(--radius-pill);
  }

  /*
   * Narrow: the flow stacks, because a four-item row plus two pills at 350px is
   * either unreadable or a horizontal scrollbar. The connectors turn with it so
   * the direction still reads.
   */
  @media (max-width: 767px) {
    .process__flow {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    .process__lines {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      padding-block: 0.9rem;
    }

    .process__link {
      flex: 0 0 auto;
      /* `min-width` from the base rule has to be cleared as well as `flex`: at
         1.25rem it wins over the 2px width and the connector renders as a green
         blob instead of a line. */
      min-width: 0;
      width: 2px;
      height: 1.6rem;
      margin-inline-start: 1.1rem;
      background: linear-gradient(
        180deg,
        transparent,
        var(--accent) 40%,
        var(--accent)
      );
    }
  }
</style>
