---
import { LANG_LABEL, LOCALES, homePath } from '../lib/site';
import type { Locale } from '../lib/site';
import { ui } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<nav class="lang" aria-label={ui(locale).languageNav}>
  <ul class="lang__list">
    {
      LOCALES.map((code) => (
        <li>
          <a
            class="detail-link"
            href={homePath(code)}
            hreflang={code}
            lang={code}
            data-lang={code}
            aria-current={code === locale ? 'page' : undefined}
          >
            {LANG_LABEL[code]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .lang__list {
    display: flex;
    align-items: center;
  }
</style>
