---
import { t } from '../lib/i18n';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const { principles } = dict;
---

{/*
  The page's argument, stated positively: three things Moovworks does not do.

  Every line restates a promise already made in the copy deck, so nothing here is
  a new claim. It carries no numbers and no client names, because a page arguing
  against hype cannot open its proof section with fabricated proof.

  It sits on a lifted band with hairlines top and bottom. That is the page's only
  change of surface across a whole section, and it is what makes the argument read
  as a chapter rather than as four more paragraphs between two other paragraphs.
*/}
<section class="principles" id="principles">
  <div class="shell">
    <header class="section__head reveal">
      <h2 class="section__title">{principles.title}</h2>
      <p class="section__lead">{principles.lead}</p>
    </header>

    <ul class="principles__list reveal-group">
      {
        principles.items.map((item) => (
          <li class="principles__item reveal">
            <h3 class="principles__title">{item.title}</h3>
            <p class="principles__text">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .principles {
    position: relative;
    overflow: clip;
    padding-block: var(--section-gap);
    background: linear-gradient(
      180deg,
      var(--canvas-soft) 0%,
      var(--canvas) 100%
    );
    border-block: 1px solid var(--edge);
  }

  .principles__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: clamp(1.75rem, 4vw, 2.5rem);
  }

  .principles__item {
    display: flex;
    flex-direction: column;
    gap: clamp(0.6rem, 1.4vw, 0.9rem);
    padding-block-start: clamp(1.25rem, 3vw, 1.75rem);
    border-block-start: 1px solid var(--line);
  }

  .principles__item:first-child {
    padding-block-start: 0;
    border-block-start: 0;
  }

  .principles__title {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .principles__text {
    color: var(--body);
  }

  @media (min-width: 901px) {
    .principles__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 4vw, 3.5rem);
      row-gap: 0;
    }

    /* Separated by vertical hairlines rather than by a rule above each item,
       which is what the services grid does. Two sections built from three-ish
       columns have to differ somehow, and the direction of the divider is the
       cheapest honest way to do it. */
    .principles__item {
      padding-block-start: 0;
      padding-inline-start: clamp(1.25rem, 3vw, 2.5rem);
      border-block-start: 0;
      border-inline-start: 1px solid var(--line);
    }

    .principles__item:first-child {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
  }
</style>
