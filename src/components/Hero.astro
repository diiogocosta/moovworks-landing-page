---
import {
  BUZZWORDS,
  FIELD_CLEAR_DELAY_MS,
  FIELD_CLEAR_DURATION_MS,
  STROKE_CASCADE_START_MS,
  STROKE_CASCADE_STEP_MS,
  STROKE_DURATION_MS,
} from '../content/buzzwords';
import type { Buzzword } from '../content/buzzwords';
import { t } from '../lib/i18n';
import { HEADLINE } from '../lib/site';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

/**
 * The whole sequence is timed from data, not from hand-written CSS delays, so
 * the cascade stays even if the word list changes length.
 */
const styleFor = (word: Buzzword, index: number) => {
  const properties = [
    `--x:${word.x}%`,
    `--y:${word.y}%`,
    `--s:${word.size}rem`,
    `--d:${STROKE_CASCADE_START_MS + index * STROKE_CASCADE_STEP_MS}ms`,
  ];

  if (word.compact) {
    properties.push(
      `--cx:${word.compact.x}%`,
      `--cy:${word.compact.y}%`,
      `--cs:${word.compact.size}rem`,
    );
  }

  return properties.join(';');
};

const timings = [
  `--stroke-duration:${STROKE_DURATION_MS}ms`,
  `--clear-delay:${FIELD_CLEAR_DELAY_MS}ms`,
  `--clear-duration:${FIELD_CLEAR_DURATION_MS}ms`,
].join(';');
---

<section class="hero dots" aria-labelledby="hero-headline" style={timings}>
  <div class="shell hero__inner">
    {/*
      The word field, timed and decorative: hidden from assistive tech, unable to
      receive events, and removed entirely when there is no JS or motion is not
      wanted. It is the joke of the headline made visible, which is why it stays
      after the 3D was retired: the words arrive, the marker crosses them out, the
      field clears. The headline is what is left standing.

      It occupies its own band, so it never overlaps the type and never causes
      layout shift.
    */}
    <div class="hero__field" aria-hidden="true">
      {
        BUZZWORDS.map((word, index) => (
          <span
            class:list={['buzz', word.compact && 'buzz--compact']}
            style={styleFor(word, index)}
          >
            <span class="buzz__text">{word.text}</span>
          </span>
        ))
      }
    </div>

    <h1 class="hero__display" id="hero-headline">
      {HEADLINE.map((line) => <span class="hero__line">{line}</span>)}
    </h1>

    <div class="hero__foot">
      <p class="hero__sub">{dict.hero.sub}</p>
      <a class="btn hero__cta" href="#contact">{dict.hero.cta}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    /* The field's words are absolutely positioned and may be wider than the
       viewport on purpose; the clip keeps that from becoming a scrollbar. */
    overflow: clip;
  }

  .hero__inner {
    /* Short by design. The space above the headline is occupied by the word
       field, not by padding: an empty hero that floats its own headline down the
       viewport is a layout bug wearing a spacer's clothes. */
    padding-block-start: clamp(2rem, 4vw, 3.5rem);
    padding-block-end: var(--section-gap);
  }

  /* ---- Word field ------------------------------------------------------ */

  .hero__field {
    position: relative;
    height: clamp(5rem, 9vw, 6.5rem);
    margin-block-end: clamp(1.5rem, 3vw, 2.5rem);
    pointer-events: none;
    animation: field-clear var(--clear-duration) ease-in var(--clear-delay) forwards;
  }

  .buzz {
    position: absolute;
    left: var(--x);
    top: var(--y);
    font-family: var(--font-sans);
    font-size: var(--s);
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
    color: var(--mute);
    /* Establishes the stacking context the marker tucks behind. */
    isolation: isolate;
  }

  .buzz__text {
    position: relative;
    z-index: 1;
  }

  /* The marker stroke. Drawn, not faded: scaleX from the left edge, with the
     slight rotation of a hand pulling a chisel tip across paper. It is the one
     place the accent is used as a mark rather than as an edge. */
  .buzz::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset-inline: -0.35em;
    inset-block-start: 50%;
    height: 0.85em;
    margin-block-start: -0.425em;
    background-color: var(--accent);
    transform: rotate(-1.5deg) scaleX(0);
    transform-origin: 0% 50%;
    animation: marker-stroke var(--stroke-duration) cubic-bezier(0.2, 0.7, 0.2, 1)
      var(--d) both;
  }

  @keyframes marker-stroke {
    from {
      transform: rotate(-1.5deg) scaleX(0);
    }
    to {
      transform: rotate(-1.5deg) scaleX(1);
    }
  }

  @keyframes field-clear {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* ---- Headline -------------------------------------------------------
   * 500, not 400. The reference sets display at regular weight, and this is one
   * documented step above it: at 72px, Inter 400 makes the sharpest line on the
   * page feel like a caption. 500 is still nowhere near the heavy display weight
   * the brand rules out, and it is the only place on the page above 600.
   */
  .hero__display {
    font-size: var(--step-display);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink-strong);
  }

  .hero__line {
    display: block;
    /* The two lines are fixed strings, so they are never allowed to break
       mid-phrase. */
    white-space: nowrap;
  }

  /* ---- Subtitle and call to action ------------------------------------ */

  .hero__foot {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: clamp(1.5rem, 4vw, 2rem);
    align-items: end;
    margin-block-start: clamp(2rem, 4vw, 3rem);
  }

  .hero__sub {
    grid-column: 1 / span 6;
    font-size: var(--step-body);
    color: var(--body);
  }

  .hero__cta {
    grid-column: 9 / -1;
    justify-self: end;
  }

  /* ---- No motion, or no JS: the hero opens clean ---------------------- */

  html:not(.js) .hero__field {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__field {
      display: none;
    }
  }

  /* ---- Narrow --------------------------------------------------------- */

  @media (max-width: 767px) {
    /* Only the words with a compact placement are drawn; the rest are the long
       ones, which would not fit a single column. */
    .buzz:not(.buzz--compact) {
      display: none;
    }

    .buzz--compact {
      left: var(--cx);
      top: var(--cy);
      font-size: var(--cs);
    }

    .hero__foot {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__sub,
    .hero__cta {
      grid-column: 1 / -1;
      justify-self: stretch;
    }

    .hero__cta {
      width: 100%;
    }
  }
</style>
