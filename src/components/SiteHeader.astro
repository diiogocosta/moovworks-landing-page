---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t } from '../lib/i18n';
import { homePath } from '../lib/site';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
  /** On the home page the contact link is an in-page anchor, not a jump home. */
  home?: boolean;
}

const { locale, home = false } = Astro.props;
const dict = t(locale);
const contactHref = home ? '#contact' : `${homePath(locale)}#contact`;
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="wordmark" href={homePath(locale)}>moovworks</a>

    <div class="site-header__end">
      <a class="detail-link" href={contactHref}>{dict.header.contact}</a>
      <LanguageSwitcher locale={locale} />
    </div>
  </div>
</header>

<style>
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: var(--header-block);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    /* Touch target, not decoration: the wordmark is the way home. */
    min-height: 44px;
    font-family: var(--font-display);
    /* Archivo set wide and lowercase: the wordmark is a name, not a label. */
    font-size: 1.25rem;
    font-weight: 700;
    font-stretch: 100%;
    letter-spacing: -0.03em;
    color: var(--tinta);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.24em;
    transition: text-decoration-color var(--transition);
  }

  .wordmark:hover {
    text-decoration-color: var(--marcador);
  }

  .site-header__end {
    display: flex;
    align-items: center;
    /* The links bring their own 44px boxes, so this gap is part of the target. */
    gap: clamp(0.5rem, 1.5vw, 1.25rem);
    margin-inline-end: -0.4rem;
  }
</style>
