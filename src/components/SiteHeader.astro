---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t } from '../lib/i18n';
import { homePath } from '../lib/site';
import type { Locale } from '../lib/site';

interface Props {
  locale: Locale;
  /** On the home page the contact link is an in-page anchor, not a jump home. */
  home?: boolean;
}

const { locale, home = false } = Astro.props;
const dict = t(locale);
const contactHref = home ? '#contact' : `${homePath(locale)}#contact`;
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="wordmark" href={homePath(locale)}>moovworks</a>

    <div class="site-header__end">
      <a class="detail-link" href={contactHref}>{dict.header.contact}</a>
      <LanguageSwitcher locale={locale} />
    </div>
  </div>
</header>

<style>
  /*
   * Sticky, and transparent where it overlaps the hero so the dot grid runs edge
   * to edge behind it. It becomes a solid bar once the page has scrolled past the
   * headline, which is the moment it stops being part of the hero and starts
   * being chrome.
   *
   * Driven by a scroll timeline rather than a scroll listener: no script, no
   * event handler, and it stays in step with the compositor instead of the main
   * thread. Where `animation-timeline` is unsupported the bar is simply always
   * solid, which is a perfectly good header.
   */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 60;
    background-color: var(--canvas);
    border-block-end: 1px solid var(--line);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .site-header {
        background-color: transparent;
        border-block-end-color: transparent;
        /* Longhands, never the `animation` shorthand — the build folds the
           timeline into the shorthand and Chromium then rejects the whole
           declaration. See the note in src/styles/global.css. */
        animation-name: header-solid;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        /* Settles well before the headline has left the viewport. */
        animation-range: 40px 180px;
      }
    }
  }

  @keyframes header-solid {
    to {
      background-color: var(--canvas);
      border-block-end-color: var(--line);
    }
  }

  .site-header__inner {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: var(--header-block);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    /* Touch target, not decoration: the wordmark is the way home. */
    min-height: 44px;
    font-family: var(--font-sans);
    /* Lowercase and lightly tracked in: the wordmark is a name, not a label. */
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--ink-strong);
    transition: color var(--transition);
  }

  .wordmark:hover {
    color: var(--accent-soft);
  }

  .site-header__end {
    display: flex;
    align-items: center;
    /* The links bring their own 44px boxes, so this gap is part of the target. */
    gap: clamp(0.5rem, 1.5vw, 1.25rem);
  }

  /*
   * The contact link is a plain label here, not a filled button. The one filled
   * accent button on the page belongs to the hero: two green blocks in the first
   * viewport would spend the accent twice on the same job.
   *
   * On a narrow phone the three language codes and the contact label together
   * are wider than the viewport, so the label is the one that goes. It is safe
   * to drop because the hero opens with the same label wired to the same anchor,
   * one scroll position below, and the language switcher is not reproducible
   * anywhere else on the page.
   */
  @media (max-width: 480px) {
    .site-header__end .detail-link {
      display: none;
    }
  }
</style>
